---
import BaseLayout from "../layouts/BaseLayout.astro"; import SiteHeader from "../components/SiteHeader.astro"; import SiteFooter from "../components/SiteFooter.astro"; import ContactCta from "../components/ContactCta.astro"; import { work } from "../data/work"; import { workMeta } from "../data/workMeta";
---
<BaseLayout title="Work | Glavas Engineering"><SiteHeader /><main><section class="section work-page"><div class="container"><div class="page-hero"><p class="eyebrow">Work</p><h1>Selected thermal assessments.</h1><p class="lead">Façade and building-envelope calculations, from project-scale packages to complex individual connections.</p></div><div class="work-list">{work.map((project, index) => <article class="work-item"><span>{workMeta[index].number}</span><div><h2>{project.title}</h2><p>{project.intro}</p></div><ContactCta label="View project" href={`/work/${workMeta[index].slug}`} event="work_view" location="work_list" /></article>)}</div></div></section></main><SiteFooter /></BaseLayout>
<style>
  .page-hero{background:url("/assets/blueprints/background-template-3.svg") center / cover no-repeat}.work-page h1{max-width:52rem}.lead{max-width:42rem;color:var(--color-slate);font-size:1.25rem}.work-list{margin-top:6rem;border-top:1px solid var(--color-light-grey)}.work-item{display:grid;grid-template-columns:4rem 1fr auto;gap:1.5rem;align-items:start;padding:1.5rem 0;border-bottom:1px solid var(--color-light-grey)}.work-item>span{color:var(--color-teal);font-size:.875rem;font-weight:500}.work-item h2{margin:0 0 .5rem;font-size:clamp(1.4rem,2.5vw,2.25rem)}.work-item p{max-width:40rem;margin:0;color:var(--color-slate);font-size:1rem}.work-item:hover h2{color:var(--color-teal)}@media(max-width:44rem){.work-list{margin-top:3.5rem}.work-item{grid-template-columns:2.5rem minmax(0,1fr);gap:.5rem 1rem}.work-item :global(.contact-cta){grid-column:2;justify-self:stretch;width:100%}.work-item h2{font-size:1.45rem}}
</style>
