---
import BaseLayout from "../layouts/BaseLayout.astro"; import SiteHeader from "../components/SiteHeader.astro"; import SiteFooter from "../components/SiteFooter.astro"; import { work } from "../data/work";
---
<BaseLayout title="Work | Glavas Engineering"><SiteHeader /><main><section class="section work-page"><div class="container"><p class="eyebrow">Work</p><h1>Selected thermal assessments.</h1><p class="lead">A selection of façade and building-envelope calculations, from project-scale packages to complex individual connections.</p><div class="case-studies">{work.map((project, index) => <article class="case-study"><div class="case-study__heading"><span>0{index + 1}</span><h2>{project.title}</h2><p>{project.intro}</p></div><div class="case-study__details"><div><h3>Scope</h3><p>{project.scope}</p></div><div><h3>Method</h3><p>{project.method}</p></div><div><h3>Output</h3><p>{project.output}</p></div></div></article>)}</div></div></section></main><SiteFooter /></BaseLayout>
<style>
  .work-page h1{max-width:52rem}.lead{max-width:42rem;color:var(--color-slate);font-size:1.25rem}.case-studies{margin-top:6rem;border-top:1px solid var(--color-light-grey)}.case-study{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(3rem,8vw,9rem);padding:3.5rem 0;border-bottom:1px solid var(--color-light-grey)}.case-study__heading>span{color:var(--color-teal);font-size:.875rem;font-weight:500}.case-study h2{margin-top:2.5rem;font-size:clamp(1.8rem,3.5vw,3rem)}.case-study__heading>p{color:var(--color-slate);font-size:1.05rem}.case-study__details{display:grid;grid-template-columns:1fr;gap:2rem}.case-study__details h3{margin-bottom:.5rem;color:var(--color-teal);font-size:.875rem;letter-spacing:.08em;text-transform:uppercase}.case-study__details p{margin:0;color:var(--color-slate);font-size:1rem}.case-study__details>div{padding-top:1rem;border-top:1px solid var(--color-light-grey)}@media(max-width:44rem){.case-studies{margin-top:3.5rem}.case-study{display:block;padding:2.5rem 0}.case-study h2{margin-top:1.5rem}.case-study__details{margin-top:2.5rem;gap:1.5rem}}
</style>
