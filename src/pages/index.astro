---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import ServiceCard from "../components/ServiceCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { CONTACT_EMAIL } from "../constants/site";
import { workMeta } from "../data/workMeta";

const services = [
  { number: "01", title: "Condensation risk assessment", description: "Thermal modelling of façade junctions to determine minimum internal surface temperatures and assess surface condensation risk." },
  { number: "02", title: "U-value calculations", description: "U-value calculations for wall assemblies, façade systems and typical façade bays, including thermal-bridge effects where required." },
  { number: "03", title: "Thermal bridge calculations", description: "Psi (ψ)- and Chi (χ)-value calculations for building-envelope junctions, connections and façade components using 2D or 3D modelling as required." },
];

const projects = [
  { number: "01", title: "2D Condensation Risk Assessment", description: "Project-scale assessment of façade junctions for internal surface temperature and condensation risk, typically covering 20–30+ details per project.", linkLabel: "View condensation risk assessment" },
  { number: "02", title: "Solid Wall U-Value & Thermal Bridge Assessment", description: "U-, Psi- and Chi-value assessment of a wall assembly using BuildDesk, Flixo and COMSOL.", linkLabel: "View wall thermal assessment" },
  { number: "03", title: "Curtain Wall U-Value & Psi-Value Assessment", description: "Frame U-value and glass-to-frame Psi-value assessment, including transom analysis using the applicable ISO methodology.", linkLabel: "View curtain wall assessment" },
  { number: "04", title: "3D Thermal Bridge Analysis of a Brise Soleil Connection", description: "3D finite-element analysis of a complex façade connection to quantify its thermal-bridge performance.", linkLabel: "View 3D thermal bridge analysis" },
  { number: "05", title: "3D Condensation Risk Assessment", description: "3D thermal analysis of a complex façade junction to determine minimum internal surface temperature and assess condensation risk.", linkLabel: "View 3D condensation assessment" },
];
---
<BaseLayout>
  <SiteHeader />
  <main>
    <section class="hero section">
      <div class="container hero__grid">
        <div>
          <p class="eyebrow">Glavas Engineering</p>
          <h1>Façade thermal analysis.</h1>
        </div>
        <div class="hero__copy">
          <p>U-value calculations, condensation risk assessments and thermal-bridge calculations for façade and building-envelope projects.</p>
          <p class="hero__detail">2D and 3D thermal modelling for standard and complex junctions.</p>
          <a class="text-link" href="/contact" data-analytics-event="contact_click" data-analytics-location="home_hero">Discuss a project</a>
        </div>
      </div>
      <div class="container hero__line" aria-hidden="true"><span></span><span>01 / 05</span></div>
    </section>

    <section class="section section--soft" id="services">
      <div class="container">
        <div class="section-heading"><p class="eyebrow">Services</p><h2>What I do</h2></div>
        <div class="service-grid">{services.map((service) => <ServiceCard {...service} />)}</div>
      </div>
    </section>

    <section class="section" id="work">
      <div class="container">
        <div class="section-heading"><p class="eyebrow">Selected work</p><h2>Technical clarity for complex details.</h2></div>
        <div class="project-grid">{projects.map((project, index) => <ProjectCard {...project} href={`/work/${workMeta[index].slug}`} />)}</div>
      </div>
    </section>

    <section class="process section section--soft" id="about">
      <div class="container process__grid">
        <div class="section-heading"><p class="eyebrow">How I work</p><h2>A clear process from detail to result.</h2></div>
        <div class="steps">
          <div class="step"><span>01</span><div><h3>Send the detail</h3><p>Drawings, specifications, project requirements and the calculation required.</p></div></div>
          <div class="step"><span>02</span><div><h3>I carry out the assessment</h3><p>The appropriate calculation method and 2D or 3D thermal model are applied according to the project requirements.</p></div></div>
          <div class="step"><span>03</span><div><h3>Receive the results</h3><p>Clear calculation outputs and technical documentation for use within the wider project.</p></div></div>
        </div>
      </div>
    </section>

    <section class="contact section" id="contact">
      <div class="container contact__inner">
        <div><p class="eyebrow">Start a project</p><h2>Need a thermal calculation?</h2></div>
        <div><p>Send the relevant detail and required calculation.</p><a class="button" href={`mailto:${CONTACT_EMAIL}`} data-analytics-event="contact_click" data-analytics-location="home_cta">Contact <span>↗</span></a></div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .hero { padding-top: clamp(6rem, 14vw, 12rem); padding-bottom: clamp(4rem, 9vw, 8rem); }
  .hero__grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(18rem, 0.75fr); gap: 4rem; align-items: end; }
  .hero h1 { max-width: 46rem; margin-bottom: 0; }
  .hero__copy { max-width: 30rem; padding-bottom: 0.75rem; }
  .hero__copy p { margin-bottom: 1.25rem; }
  .hero__detail { color: var(--color-slate); font-size: 1rem; }
  .hero__line { display: flex; align-items: center; gap: 1rem; margin-top: 7rem; color: var(--color-slate); font-size: 0.75rem; }
  .hero__line span:first-child { height: 1px; flex: 1; background: var(--color-light-grey); }
  .service-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; }
  .project-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; background: var(--color-light-grey); }
  .project-grid :global(.project-card:last-child) { grid-column: span 2; min-height: 18rem; }
  .process__grid { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: 8rem; }
  .steps { border-top: 1px solid var(--color-light-grey); }
  .step { display: grid; grid-template-columns: 4rem 1fr; gap: 1rem; padding: 1.5rem 0; border-bottom: 1px solid var(--color-light-grey); }
  .step > span { color: var(--color-teal); font-size: 0.875rem; font-weight: 500; }
  .step h3 { margin-bottom: 0.4rem; }
  .step p, .contact p { color: var(--color-slate); }
  .step p { margin-bottom: 0; font-size: 1rem; }
  .contact { background: var(--color-teal); color: var(--color-white); }
  .contact__inner { display: grid; grid-template-columns: 1fr 0.75fr; gap: 4rem; align-items: end; }
  .contact .eyebrow, .contact p { color: var(--color-light-grey); }
  .contact h2 { margin-bottom: 0; }
  .contact__inner > div:last-child p { color: var(--color-white); }
  .contact .button { border-color: var(--color-white); background: var(--color-white); color: var(--color-teal); }
  .contact .button:hover, .contact .button:focus-visible { border-color: var(--color-charcoal); color: var(--color-white); }
  .button span { margin-left: 0.6rem; }
  @media (max-width: 55rem) { .process__grid { gap: 4rem; } }
  @media (max-width: 44rem) {
    .hero__grid, .process__grid, .contact__inner { grid-template-columns: 1fr; gap: 2.5rem; }
    .hero__copy { padding-bottom: 0; }
    .hero__line { margin-top: 4rem; }
    .service-grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .project-grid { grid-template-columns: 1fr; }
    .project-grid :global(.project-card:last-child) { grid-column: auto; }
  }
</style>
