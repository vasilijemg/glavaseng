---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import ServiceCard from "../components/ServiceCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ContactCta from "../components/ContactCta.astro";
import DiscussProjectSection from "../components/DiscussProjectSection.astro";
import { CONTACT_EMAIL } from "../constants/site";
import { workMeta } from "../data/workMeta";

const services = [
  { number: "01", title: "Condensation risk assessment", description: "Thermal modelling of façade junctions to determine minimum internal surface temperatures and assess surface condensation risk." },
  { number: "02", title: "U-value calculations", description: "U-value calculations for wall assemblies, façade systems and typical façade bays, including thermal-bridge effects where required." },
  { number: "03", title: "Thermal bridge calculations", description: "Psi (ψ)- and Chi (χ)-value calculations for building-envelope junctions, connections and façade components using 2D or 3D modelling as required." },
];

const projects = [
{ number: "01", title: "2D Condensation Risk Assessment", description: "Project-scale assessment of façade junctions for internal surface temperature and condensation risk, covering 20+ details for the project.", linkLabel: "View the project" },
{ number: "02", title: "Solid Wall U-Value", description: "U-, Psi- and Chi-value assessment of a wall assembly using BuildDesk, Flixo and COMSOL.", linkLabel: "View the project" },
{ number: "03", title: "Curtain Wall U-Value & Psi-Value Assessment", description: "Frame U-value and glass-to-frame Psi-value assessment, including transom analysis using the applicable ISO methodology.", linkLabel: "View the project" },
{ number: "04", title: "3D Thermal Bridge Analysis of a Brise-Soleil Connection", description: "3D finite-element analysis of a complex façade connection to quantify its thermal-bridge performance.", linkLabel: "View the project" },

];
---
<BaseLayout>
  <SiteHeader />
  <main>
    <section class="hero section">

      <div class="container hero__grid">
        <div>
          <h1>Façade thermal analysis.</h1>
        </div>
        <div class="hero__copy">
          <p>U-value calculations, condensation risk assessments and thermal-bridge calculations for façade and building-envelope projects.</p>
          <p class="hero__detail">2D and 3D thermal modelling for standard and complex junctions.</p>
          <ContactCta location="home_hero" />
        </div>
      </div>
    </section>

    <section class="section section--soft" id="services">
      <div class="container">
        <div class="section-heading"><p class="eyebrow">Services</p><h2>What we offer</h2></div>
        <div class="service-grid">{services.map((service) => <ServiceCard {...service} />)}</div>
      </div>
    </section>

    <section class="section" id="work">
      <div class="container">
        <div class="section-heading"><p class="eyebrow">Selected work</p><h2>Clear analysis for complex details</h2></div>
        <div class="project-grid">{projects.map((project, index) => <ProjectCard {...project} href={"/work/" + workMeta[index].slug} />)}</div>
        <div class="selected-work-cta"><ContactCta label="View more" href="/work" event="work_view_more" location="home_selected_work" inverted /></div>
      </div>
    </section>

    <section class="process section section--soft" id="about">
      <div class="container process__grid">
        <div class="section-heading"><p class="eyebrow">Our approach</p><h2>A clear route throughout the work process</h2></div>
        <div class="steps">
          <div class="step"><span>01</span><div><h3>Send the project information</h3><p>Drawings, specifications, project requirements and the calculation required.</p></div></div>
          <div class="step"><span>02</span><div><h3>The assessment is carried out</h3><p>The appropriate calculation method and 2D or 3D thermal model are applied according to the project requirements.</p></div></div>
          <div class="step"><span>03</span><div><h3>Receive the results</h3><p>Clear calculation outputs and technical documentation for use within the wider project.</p></div></div>
        </div>
      </div>
    </section>

    <DiscussProjectSection location="home_cta" />
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .hero { position: relative; overflow: hidden; background:url("/assets/blueprints/background-template-1.svg") center / cover no-repeat; padding-top: clamp(6rem, 14vw, 12rem); padding-bottom: clamp(4rem, 9vw, 8rem); }

  .hero__grid { position: relative; z-index: 1; }
  .hero__grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(18rem, 0.75fr); gap: 4rem; align-items: end; }
  .hero h1 { max-width: 46rem; margin-bottom: 0; }
  .hero__copy { max-width: 30rem; padding-bottom: 0.75rem; }
  .hero__copy p { margin-bottom: 1.25rem; }
  .hero__detail { color: var(--color-slate); font-size: 1rem; }
  .service-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; }
  .project-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; background: var(--color-light-grey); }
  .selected-work-cta { display: flex; justify-content: flex-end; margin-top: 20px; }
  .process__grid { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: 8rem; }
  .steps { border-top: 1px solid var(--color-light-grey); }
  .step { display: grid; grid-template-columns: 4rem 1fr; gap: 1rem; padding: 1.5rem 0; border-bottom: 1px solid var(--color-light-grey); }
  .step > span { color: var(--color-teal); font-size: 0.875rem; font-weight: 500; }
  .step h3 { margin-bottom: 0.4rem; }
  .step p, .contact p { color: var(--color-slate); }
  .step p { margin-bottom: 0; font-size: 1rem; }
  @media (max-width: 55rem) { .process__grid { gap: 4rem; } }
  @media (max-width: 44rem) {
    .hero { background-image:url("/assets/blueprints/background-template-1-mobile.svg"); }
    .hero__grid, .process__grid, .contact__inner { grid-template-columns: 1fr; gap: 2.5rem; }
    .hero__copy { padding-bottom: 0; }
    .service-grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .project-grid { grid-template-columns: 1fr; }


  }
</style>
