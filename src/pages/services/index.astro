---
import BaseLayout from "../../layouts/BaseLayout.astro"; import SiteHeader
    from "../../components/SiteHeader.astro"; import SiteFooter
    from "../../components/SiteFooter.astro"; import ContactCta from "../../components/ContactCta.astro"; import {
    services
} from "../../data/services";
---
<BaseLayout title="Services | Glavas Engineering">
    <SiteHeader/>
    <main>
        <section class="section services-page">
            <div class="container">
                <div class="page-hero"><p class="eyebrow">Services</p>
                    <h1>Thermal analysis for the building envelope.</h1></div>
                <div class="service-list">{services.map((service, i) =>
                        <article><span>0{i + 1}</span>
                            <h2><a href={"/services/" + service.slug + "/"}>{service.title}</a></h2>
                            <p>{service.intro}</p>
                            <ContactCta label="Read more" href={`/services/${service.slug}/`} event="service_view"
                                        location="service_list"/>
                        </article>)}</div>
            </div>
        </section>
    </main>
    <SiteFooter/>
</BaseLayout>
<style>
    .page-hero {
        background: url("/assets/blueprints/background-template-2.svg") center / cover no-repeat
    }

    .page-hero h1 {
        margin-bottom: 0
    }

    .service-list {
        margin-top: 6rem
    }

    h1 {
        max-width: 52rem;
        margin-bottom: 6rem;
    }

    .service-list {
        border-top: 1px solid var(--color-light-grey);
    }

    .service-list article {
        display: grid;
        grid-template-columns:4rem 1fr 1.2fr auto;
        gap: 1.5rem;
        align-items: start;
        padding: 1.5rem 0;
        border-bottom: 1px solid var(--color-light-grey);
    }

    .service-list article > span {
        color: var(--color-teal);
        font-size: .875rem;
        font-weight: 500;
    }

    .service-list h2 {
        margin: 0;
        font-size: clamp(1.4rem, 2.5vw, 2.25rem);
    }

    .service-list h2 a {
        color: inherit;
        text-decoration: none;
    }

    .service-list h2 a:hover, .service-list h2 a:focus-visible {
        color: var(--color-teal);
    }

    .service-list p {
        margin: 0;
        color: var(--color-slate);
        font-size: 1rem;
    }

    @media (max-width: 44rem) {
        .page-hero {
            background-image: url("/assets/blueprints/background-template-2-mobile.svg")
        }

        h1 {
            margin-bottom: 3rem
        }

        .service-list article {
            grid-template-columns:2.5rem minmax(0, 1fr);
            gap: .5rem 1rem
        }

        .service-list p, .service-list :global(.contact-cta) {
            grid-column: 2
        }

        .service-list :global(.contact-cta) {
            justify-self: stretch;
            width: 100%;
            margin-top: .5rem
        }
    }
</style>
