---
import BaseLayout from "../../layouts/BaseLayout.astro"; import SiteHeader from "../../components/SiteHeader.astro"; import SiteFooter from "../../components/SiteFooter.astro"; import { services } from "../../data/services";
---
<BaseLayout title="Services | Glavas Engineering"><SiteHeader /><main><section class="section"><div class="container"><p class="eyebrow">Services</p><h1>Thermal analysis for the building envelope.</h1><div class="service-list">{services.map((service, i) => <a href={`/services/${service.slug}`}><span>0{i + 1}</span><h2>{service.title}</h2><p>{service.intro}</p><b>Read more ↗</b></a>)}</div></div></section></main><SiteFooter /></BaseLayout>
<style>
  h1 { max-width: 52rem; margin-bottom: 6rem; } .service-list { border-top:1px solid var(--color-light-grey); } .service-list a { display:grid; grid-template-columns:4rem 1fr 1.2fr auto; gap:1.5rem; align-items:start; padding:1.5rem 0; border-bottom:1px solid var(--color-light-grey); text-decoration:none; } .service-list span,.service-list b { color:var(--color-teal); font-size:.875rem; font-weight:500; } .service-list h2 { margin:0; font-size:clamp(1.4rem,2.5vw,2.25rem); } .service-list p { margin:0; color:var(--color-slate); font-size:1rem; } @media(max-width:44rem){ h1{margin-bottom:3rem}.service-list a{grid-template-columns:2.5rem 1fr;gap:.5rem 1rem}.service-list p,.service-list b{grid-column:2}.service-list b{margin-top:.5rem} }
</style>
