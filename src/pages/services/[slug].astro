---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import ServiceDetail from "../../components/ServiceDetail.astro";
import { services } from "../../data/services";
export function getStaticPaths() { return services.map((service) => ({ params: { slug: service.slug }, props: { service } })); }
const { service } = Astro.props; const serviceIndex = services.findIndex((item) => item.slug === service.slug); const backgroundTemplate = serviceIndex + 2;
---
<BaseLayout title={`${service.title} | Glavas Engineering`}><SiteHeader /><main><ServiceDetail service={service} backgroundTemplate={backgroundTemplate} /></main><SiteFooter /></BaseLayout>
