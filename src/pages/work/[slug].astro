---
import BaseLayout from "../../layouts/BaseLayout.astro"; import SiteHeader from "../../components/SiteHeader.astro"; import SiteFooter from "../../components/SiteFooter.astro"; import ProjectCarousel from "../../components/ProjectCarousel.astro"; import { work } from "../../data/work"; import { workMeta } from "../../data/workMeta";
export function getStaticPaths(){return work.map((project,index)=>({params:{slug:workMeta[index].slug},props:{project,meta:workMeta[index]}}));}
const { project, meta } = Astro.props; const backgroundTemplate = meta.number === "05" ? 1 : Number(meta.number);
---
<BaseLayout title={`${project.title} | Glavas Engineering`}><SiteHeader /><main><section class="section project-page"><div class="container"><div class="project-heading" style={`background-image: url(/assets/blueprints/background-template-${backgroundTemplate}.svg); --blueprint-mobile: url(/assets/blueprints/background-template-${backgroundTemplate}-mobile.svg)`}><p class="eyebrow">Work / {meta.number}</p><h1>{project.title}</h1><p class="lead">{project.intro}</p></div><div class="project-details"><div><h2>Scope</h2><p>{project.scope}</p></div><div><h2>Method</h2><p>{project.method}</p></div><div><h2>Output</h2><p>{project.output}</p></div></div><ProjectCarousel images={meta.images} title={project.title} /></div></section></main><SiteFooter /></BaseLayout>
<style>
  .project-heading{max-width:none;background-position:center;background-size:cover;background-repeat:no-repeat}.project-heading h1{margin-bottom:1.5rem}.lead{max-width:44rem;color:var(--color-slate);font-size:clamp(1.2rem,2vw,1.5rem)}.project-details{display:grid;grid-template-columns:repeat(3,1fr);gap:2rem;padding:0 0 4rem}.project-details>div{padding-top:1rem;border-top:1px solid var(--color-light-grey)}.project-details h2{color:var(--color-teal);font-size:.875rem;letter-spacing:.08em;text-transform:uppercase}.project-details p{color:var(--color-slate);font-size:1rem}@media(max-width:44rem){.project-heading{background-image:var(--blueprint-mobile)}.project-details{grid-template-columns:1fr;padding:0 0 3rem;gap:1.5rem}}
</style>
