---
import BaseLayout from "../../layouts/BaseLayout.astro"; import SiteHeader from "../../components/SiteHeader.astro"; import SiteFooter from "../../components/SiteFooter.astro"; import ProjectCarousel from "../../components/ProjectCarousel.astro"; import { work } from "../../data/work"; import { workMeta } from "../../data/workMeta";
export function getStaticPaths(){return work.map((project,index)=>({params:{slug:workMeta[index].slug},props:{project,meta:workMeta[index]}}));}
const { project, meta } = Astro.props;
---
<BaseLayout title={`${project.title} | Glavas Engineering`}><SiteHeader /><main><section class="section project-page"><div class="container"><a class="back-link" href="/work">← All work</a><div class="project-heading"><p class="eyebrow">Work / {meta.number}</p><h1>{project.title}</h1><p class="lead">{project.intro}</p></div><div class="project-details"><div><h2>Scope</h2><p>{project.scope}</p></div><div><h2>Method</h2><p>{project.method}</p></div><div><h2>Output</h2><p>{project.output}</p></div></div><ProjectCarousel images={meta.images} title={project.title} /></div></section></main><SiteFooter /></BaseLayout>
<style>
  .back-link{display:inline-block;margin-bottom:5rem;color:var(--color-teal);font-size:.9375rem;font-weight:500;text-decoration:none}.project-heading{max-width:58rem;padding-bottom:5rem;border-bottom:1px solid var(--color-light-grey)}.project-heading h1{margin-bottom:1.5rem}.lead{max-width:44rem;color:var(--color-slate);font-size:clamp(1.2rem,2vw,1.5rem)}.project-details{display:grid;grid-template-columns:repeat(3,1fr);gap:2rem;padding:4rem 0}.project-details>div{padding-top:1rem;border-top:1px solid var(--color-light-grey)}.project-details h2{color:var(--color-teal);font-size:.875rem;letter-spacing:.08em;text-transform:uppercase}.project-details p{color:var(--color-slate);font-size:1rem}@media(max-width:44rem){.back-link{margin-bottom:3rem}.project-heading{padding-bottom:3rem}.project-details{grid-template-columns:1fr;padding:3rem 0;gap:1.5rem}}
</style>
