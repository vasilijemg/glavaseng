---
interface Props { number: string; title: string; description: string; }
const { number, title, description } = Astro.props;
---
<article class="service-card">
  <p class="service-card__number">{number}</p>
  <h3>{title}</h3>
  <p>{description}</p>
</article>

<style>
  .service-card { padding-top: 1.25rem; border-top: 1px solid var(--color-light-grey); }
  .service-card__number { margin-bottom: 3.5rem; color: var(--color-teal); font-size: 0.875rem; font-weight: 500; }
  .service-card h3 { margin-bottom: 0.75rem; }
  .service-card > p:last-child { margin-bottom: 0; color: var(--color-slate); font-size: 1rem; line-height: 1.65; }
  @media (max-width: 44rem) { .service-card__number { margin-bottom: 2rem; } }
</style>
