---
interface Props { number: string; title: string; description: string; linkLabel?: string; href?: string; }
import ContactCta from "./ContactCta.astro";
const { number, title, description, href = "/contact" } = Astro.props;
const imagePath = "/assets/projects/" + Number(number) + ".1.jpg";
---
<article class="project-card">
  <img class="project-card__image" src={imagePath} alt="" loading="lazy" />
  <div class="project-card__content">
    <h3>{title}</h3>
    <p>{description}</p>
    <ContactCta label="View the project" href={href} variant="default" event="work_view" location="project_card" />
  </div>
</article>

<style>
  .project-card { display: flex; min-height: 18rem; gap: 16px; padding: 1rem; background: var(--color-off-white); }
  .project-card__image { flex: 0 0 16rem; width: 16rem; height: 16rem; max-width: 100%; min-height: 0; align-self: center; border: 1px solid var(--color-teal); border-radius: 0.75rem; object-fit: cover; background: transparent; }
  .project-card__content { display: flex; min-width: 0; flex: 1 1 auto; flex-direction: column; justify-content: center; overflow: hidden; padding: 1rem 0; background: transparent; }
  .project-card h3 { margin-bottom: 0.5rem; font-size: clamp(1.15rem, 1.7vw, 1.4rem); }
  .project-card p { max-width: 42rem; margin-bottom: 1rem; color: var(--color-slate); font-size: 0.95rem; line-height: 1.5; }
  .project-card :global(.contact-cta) { align-self: flex-start; }
  @media (max-width: 44rem) {
    .project-card { flex-direction: column; min-height: 0; gap: 1.5rem; padding: 1rem; }
    .project-card__image { flex: 0 0 auto; width: 100%; max-width: 18rem; height: auto; min-height: 0; aspect-ratio: 1; }
    .project-card__content { flex: 0 0 auto; }
    .project-card__content { height: auto; overflow: visible; padding: 0; }
    .project-card h3 { font-size: 1.25rem; }
    .project-card :global(.contact-cta) { align-self: stretch; width: 100%; }
  }
</style>