---
interface Props {
  label?: string;
  href?: string;
  variant?: "default" | "inverse" | "header";
  location?: string;
  event?: string;
  inverted?: boolean;
}

const {
  label = "Discuss a project",
  href = "/contact/",
  variant = "default",
  location = "cta",
  event = "contact_click",
  inverted = false,
} = Astro.props;
---

<a class:list={["contact-cta", "contact-cta--" + variant, { "contact-cta--inverted": inverted }]} href={href} data-analytics-event={event} data-analytics-location={location}>
  {label}<span aria-hidden="true">↗</span>
</a>

<style>
  .contact-cta { display: inline-flex; max-width: 100%; min-width: 0; align-items: center; justify-content: center; min-height: 3rem; padding: 0.75rem 1.2rem; border: 1px solid var(--color-teal); border-radius: var(--radius-sm); background: transparent; color: var(--color-teal); font-size: 0.9375rem; font-weight: 500; line-height: 1.3; text-align: center; text-decoration: none; white-space: normal; overflow-wrap: anywhere; transition: background 180ms ease, border-color 180ms ease, color 180ms ease, transform 180ms ease; }
  .contact-cta span { margin-left: 0.6rem; transition: transform 180ms ease; }
  .contact-cta:hover, .contact-cta:focus-visible { border-color: var(--color-teal); background: var(--color-teal); color: var(--color-white); transform: translateY(-2px); }
  .contact-cta:hover span, .contact-cta:focus-visible span { transform: translate(0.15rem, -0.15rem); }
  .contact-cta--inverse { border-color: var(--color-white); color: var(--color-white); }
  .contact-cta--inverse:hover, .contact-cta--inverse:focus-visible { border-color: var(--color-white); background: var(--color-white); color: var(--color-teal); }
  .contact-cta--inverted { border-color: var(--color-teal); background: var(--color-teal); color: var(--color-white); }
  .contact-cta--inverted:hover, .contact-cta--inverted:focus-visible { border-color: var(--color-teal); background: transparent; color: var(--color-teal); }
  .contact-cta--header { min-height: auto; padding: 0.45rem 0; border-width: 0 0 2px; border-radius: 0; }
  .contact-cta--header:hover, .contact-cta--header:focus-visible { border-color: var(--color-teal); background: transparent; color: var(--color-teal); transform: none; }
  @media (max-width: 36rem) { .contact-cta--header { display: none; } }
</style>