---
import { LINKEDIN_URL } from "../constants/site";
---
<footer class="site-footer">
  <div class="container site-footer__inner">
    <p class="logo"><img src="/assets/brand/logo-charcoal.svg" alt="Glavas Engineering" /></p>
    <p>Façade thermal analysis and building-envelope consultancy.</p>
    <a class="linkedin-link" href={LINKEDIN_URL} target="_blank" rel="noreferrer" aria-label="Glavas Engineering on LinkedIn"><img src="/assets/icons/linkedin.svg" alt="" /></a>
    <p class="copyright">© {new Date().getFullYear()} Glavas Engineering</p>
  </div>
</footer>

<style>
  .site-footer { padding: 2rem 0; background: var(--color-charcoal); color: var(--color-white); }
  .site-footer__inner { display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
  .site-footer p { margin: 0; color: var(--color-light-grey); font-size: 0.875rem; }
  .linkedin-link { display: grid; width: 1.5rem; height: 1.5rem; place-items: center; color: var(--color-white); }
  .linkedin-link img { width: 100%; height: 100%; }
  .linkedin-link:hover, .linkedin-link:focus-visible { color: var(--color-light-grey); }
  .site-footer .logo { width: clamp(10.5rem, 17vw, 13rem); line-height: 0; }
  .site-footer .logo img { width: 100%; filter: brightness(0) invert(1); }
  .copyright { white-space: nowrap; }
  @media (max-width: 44rem) { .site-footer__inner { align-items: flex-start; flex-direction: column; gap: 1rem; } .copyright { white-space: normal; } }
</style>
