---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Glavas Engineering | Façade thermal analysis",
  description = "Façade thermal analysis, U-value calculations, condensation risk assessments and thermal-bridge calculations.",
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/assets/brand/favicon.svg" />
  </head>
  <body>
    <slot />
  </body>
</html>
