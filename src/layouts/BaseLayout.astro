---
import "../styles/global.css";
import Analytics from "../components/Analytics.astro";
import { CONTACT_EMAIL, SITE_URL } from "../constants/site";
import { services } from "../data/services";
import { work } from "../data/work";
import { workMeta } from "../data/workMeta";

interface Props { title?: string; description?: string; }

const { title = "Glavas Engineering | Facade thermal analysis", description } = Astro.props;
const defaultDescription = "Facade thermal analysis, U-value calculations, condensation risk assessments and thermal-bridge calculations.";
const pageDescriptions: Record<string, string> = {
  "/": "Facade thermal analysis, U-value calculations, condensation risk assessments and thermal-bridge calculations for building-envelope projects.",
  "/services": "Facade thermal analysis services including thermal bridge, condensation risk and U-value calculations.",
  "/work": "Selected facade and building-envelope thermal assessment projects using 2D and 3D modelling.",
  "/about": "About an architect specialising in facade and building-envelope thermal analysis and facade engineering.",
  "/contact": "Contact Glavas Engineering about U-value calculations, condensation risk assessment and thermal bridge analysis.",
};
services.forEach((service) => { pageDescriptions[`/services/${service.slug}`] = service.intro; });
work.forEach((project, index) => { pageDescriptions[`/work/${workMeta[index].slug}`] = project.intro; });
const metaDescription = description ?? pageDescriptions[Astro.url.pathname] ?? defaultDescription;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "Glavas Engineering",
  url: SITE_URL,
  logo: `${SITE_URL}/assets/brand/logo-charcoal.svg`,
  email: CONTACT_EMAIL,
  description: metaDescription,
  areaServed: "United Kingdom",
  serviceType: "Facade and building-envelope thermal analysis",
  contactPoint: { "@type": "ContactPoint", contactType: "customer enquiries", email: CONTACT_EMAIL },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/assets/brand/favicon.svg" />
    <link rel="canonical" href={new URL(Astro.url.pathname, SITE_URL).toString()} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Glavas Engineering" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={new URL(Astro.url.pathname, SITE_URL).toString()} />
    <meta property="og:image" content={`${SITE_URL}/assets/og-image.svg`} />
    <meta property="og:image:type" content="image/svg+xml" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Glavas Engineering – Façade thermal analysis" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:image" content={`${SITE_URL}/assets/og-image.svg`} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <Analytics />
  </head>
  <body><slot /></body>
</html>
